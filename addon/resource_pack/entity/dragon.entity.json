{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dragon_rider:dragon",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/dragon"
      },
      "geometry": {
        "default": "geometry.dragon_rider"
      },
      "animations": {
        "idle": "animation.dragon.idle",
        "fly": "animation.dragon.fly"
      },
      "scripts": {
        "animate": [
          "idle",
          { "fly": "query.is_riding || !query.is_on_ground" }
        ]
      },
      "render_controllers": ["controller.render.dragon"]
    }
  }
}
